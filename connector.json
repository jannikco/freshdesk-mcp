  "tools": [
    {
      "name": "freshdesk_list_tickets",
      "description": "Read one bounded page of tickets visible to the API key owner.",
      "method": "GET",
      "path": "/tickets",
      "readOnly": true,
      "approvalRequired": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "page": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "bindings": {
        "path": [],
        "query": {
          "per_page": "per_page",
          "page": "page"
        },
        "body": {}
      },
      "sampleArguments": {
        "per_page": 10,
        "page": 1
      },
      "evidence": {
        "state": "documented",
        "providerLiveValidation": "not-run"
      },
      "provenance": [
        "https://developers.freshdesk.com/api/"
      ]
    },
    {
      "name": "freshdesk_create_ticket",
      "description": "Create a ticket; this may trigger configured notifications and automation.",
      "method": "POST",
      "path": "/tickets",
      "readOnly": false,
      "approvalRequired": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer",
            "enum": [
              1,
              2,
              3,
              4
            ]
          }
        },
        "required": [
          "email",
          "subject",
          "description",
          "priority"
        ],
        "additionalProperties": false
      },
      "bindings": {
        "path": [],
        "query": {},
        "body": {
          "email": "email",
          "subject": "subject",
          "description": "description",
          "priority": "priority"
        }
      },
      "sampleArguments": {
        "email": "sandbox@example.com",
        "subject": "Sandbox support request",
        "description": "Authorized sandbox test",
        "priority": 1
      },
      "evidence": {
        "state": "documented",
        "providerLiveValidation": "not-run"
      },
      "body": {
        "status": 2
      },
      "provenance": [
        "https://developers.freshdesk.com/api/"
      ]
    }
